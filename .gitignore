# === FILE SUMMARY ===
# Purpose: Specify files and directories for Git to ignore in the zetom project.
# Responsible for: Preventing commits of environment files, caches, databases, and tooling artifacts.
# Connected to: Git version control behaviour across the repository.
# Important classes/functions: None
# Notes: Keeps .env.example tracked while ignoring real environment files and build outputs.
# =====================================
# Byte-compiled / cache
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
ENV/

# Logs
*.log

# Environment files
.env
*.env
.env.*
!.env.example

# Django artifacts
db.sqlite3
*.sqlite3
cache/
media/
staticfiles/

# Test / type-check cache
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE / OS files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
